# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real .env file anywhere, or share it.

# --- TMDB ---
TMDB_API_KEY=your_tmdb_api_key_here

# --- IGDB (Twitch developer app credentials) ---
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# --- Relay's own access control (for desktop app installations) ---
# Generate a long random string, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 40|%{[char]$_})
RELAY_SHARED_SECRET=change_me_to_a_long_random_string

# --- Admin dashboard login (separate from the secret above — this
# gates the usage-stats/MOTD page at /admin, not the API itself) ---
ADMIN_PASSWORD=change_me_to_a_different_long_random_string

# --- Optional tuning (defaults shown) ---
# Search results (what titles match a query) rarely change; a details/
# date fetch (release dates, episode air dates) is exactly what CAN
# shift, so it gets refreshed sooner. Values are in seconds.
CACHE_TTL_SEARCH_SECONDS=86400
CACHE_TTL_DETAILS_SECONDS=21600
RATE_LIMIT_PER_MINUTE=300

# Set to "true" to run without real TMDB/IGDB credentials at all, using
# canned mock responses instead — useful for testing the relay itself
# (auth, routing, caching, admin dashboard) before you have real API
# keys wired in, or just to see the dashboard populate with fake data.
MOCK_UPSTREAM=false

# --- NAS / Docker deployment only (deploy/nas) ---
# The compose file reads these; the Windows setup never needed them.
# RELAY_DOMAIN is the full hostname Caddy gets a certificate for.
# DUCKDNS_DOMAIN is the SUBDOMAIN ONLY -- "yourname", not the full hostname.
RELAY_DOMAIN=yourname.duckdns.org
DUCKDNS_DOMAIN=yourname
DUCKDNS_TOKEN=your_duckdns_token_here
