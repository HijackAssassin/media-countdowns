# =============================================================================
#  Media Countdowns Notifier — what should never be committed
#
#  This repo tracked ~800 files under build/: object files, moc output,
#  clangd index shards, ninja logs and the built .exe. All of it is
#  regenerated by configuring and building, all of it churns on every single
#  compile, and together it buried the six files that are actually the
#  program. The main app repo hit exactly this and was cleaned up in V5 —
#  this is the same list, so both projects ignore the same things.
# =============================================================================

# Build output — any configuration, any generator
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*_autogen/
.ninja_deps
.ninja_log
.qtc_clangd/

# Qt / CMake generated sources
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc

# Qt Creator per-user settings — machine-specific, differs per developer
*.user
*.user.*
.qtcreator/
CMakeLists.txt.user*

# Compiled objects and binaries
*.o
*.obj
*.exe
*.dll
*.a
*.so
*.dylib
*.pdb
*.ilk

# Local convenience scripts — useful on this machine, not part of the program
clean.bat

# OS / editor cruft
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# The public, keyless mirror of this source — its own git repo inside this
# working tree, so it must be ignored here or `git add -A` records it as a
# nested gitlink. See the main app's .gitignore for the same note.
MediaCountdownsNotifierPublic/
