// Windows version resource, generated by CMake from src/notifierversion.h.
//
// V5.4.25 gave this program a version "so a bug report naming the notifier
// could be tied to a build". It could not: nothing included the header and
// there was no version resource, so the number existed only in CMake and
// appeared nowhere in the shipped .exe. This is what actually stamps it —
// right-click → Properties → Details now names the build.
//
// The tray tooltip carries it too (TrayApp's constructor), because that is the
// only UI this program has and hovering the icon is how a user would ever be
// asked "which version are you running?".
//
// Deliberately includes no header — see the main app's copy of this file for
// why (the RC compile rule has no include directories). VS_VERSION_INFO is 1.
//
// Do not edit the version here. It comes from src/notifierversion.h via CMake.
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Patrick Price"
            VALUE "FileDescription",  "Media Countdowns Notifier"
            VALUE "FileVersion",      "@MC_NOTIFIER_VERSION@"
            VALUE "InternalName",     "MediaCountdownsNotifier"
            VALUE "OriginalFilename", "MediaCountdownsNotifier.exe"
            VALUE "ProductName",      "Media Countdowns"
            VALUE "ProductVersion",   "@MC_NOTIFIER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
