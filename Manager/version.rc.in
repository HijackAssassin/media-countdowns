// Windows version resource, generated by CMake from src/appversion.h.
//
// Without this the .exe carried NO version at all: right-click → Properties →
// Details was blank, and so was anything that reads a file version. The number
// was compiled in as a string (the window title reads MC_APP_VERSION), which
// is why grepping the binary for it worked while Explorer showed nothing.
//
// Deliberately includes no header. The RC compile rule in CMakeLists is
// stripped of its include directories — windres forwards them unquoted and the
// space in "Media Countdowns" splits the path — so anything needing winver.h
// would fail to build. VS_VERSION_INFO is 1; the FILEOS/FILETYPE constants
// below are VOS_NT_WINDOWS32 (0x40004) and VFT_APP (0x1), written out.
//
// Do not edit the version here. It comes from src/appversion.h via CMake, and
// CMAKE_CONFIGURE_DEPENDS makes a bump re-run configure so this is regenerated.
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Patrick Price"
            VALUE "FileDescription",  "Media Countdowns"
            VALUE "FileVersion",      "@MC_VERSION@"
            VALUE "InternalName",     "MediaCountdowns"
            VALUE "OriginalFilename", "MediaCountdowns.exe"
            VALUE "ProductName",      "Media Countdowns"
            VALUE "ProductVersion",   "@MC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
